{
  "ConnectionStrings": {
    "Main": "Server=localhost;Database=MojaAplikacija2;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
